@startuml
title I-ITSM Architecture & Class Diagram (Phases 1 & 2)
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 8

package "com.iitsm.domain.model" {

    abstract class User {
        - id: String
        - name: String
        - email: Email
        - passwordHash: String
        - role: UserRole
        - active: boolean
        - failedLoginAttempts: int
        - locked: boolean
        + recordFailedLogin(maxAllowed: int): void
        + resetFailedLogins(): void
    }

    class Employee {
        - designation: Designation
        - department: String
        - seniorityYears: int
    }

    class Technician {
        - skills: Set<Skill>
        - experienceYears: int
        - maxCapacity: int
        - availabilityStatus: AvailabilityStatus
        - supportTeamId: String
        - activeIncidentIds: Set<String>
        + assignIncident(incidentId: String): void
        + releaseIncident(incidentId: String): void
        + isAvailableForAssignment(): boolean
        + getLoadRatio(): double
    }

    class TeamLead {
    }

    class Administrator {
        - adminLevel: AdminLevel
        + isSystemAdmin(): boolean
        + isItManager(): boolean
    }

    User <|-- Employee
    User <|-- Technician
    Technician <|-- TeamLead
    User <|-- Administrator

    class Incident <<Aggregate Root>> {
        - id: String
        - title: String
        - description: String
        - reporterId: String
        - createdAt: Instant
        - category: IncidentCategory
        - serviceId: String
        - priorityDecision: PriorityDecision
        - status: IncidentStatus
        - assigneeId: String
        - reopenCount: int
        - linkedIncidentIds: Set<String>
        - version: Long
        + classify(...): void
        + assign(...): void
        + acknowledge(...): void
        + startInvestigation(...): void
        + requestInfo(...): void
        + provideInfo(...): void
        + resolve(...): void
        + verify(...): void
        + reject(...): void
        + close(...): void
        + flagWrongDomain(...): void
        + getAllowedActions(): Set<String>
    }

    class SlaTracker {
        - createdAt: Instant
        - responseDueAt: Instant
        - resolutionDueAt: Instant
        - respondedAt: Instant
        - resolvedAt: Instant
        - pausedDuration: Duration
        - pausedAt: Instant
        - status: SlaStatus
        + recordResponse(now: Instant): void
        + recordResolution(now: Instant): void
        + pauseClock(now: Instant): void
        + resumeClock(now: Instant): void
        + evaluateStatus(now: Instant): void
    }

    class SlaPolicy {
        - id: String
        - priority: Priority
        - serviceIdOverride: String
        - responseTarget: Duration
        - resolutionTarget: Duration
        - warningThresholdRatio: double
    }

    class ItService {
        - id: String
        - name: String
        - owningTeamId: String
        - businessCriticality: BusinessCriticality
        - userBase: int
        - keywords: Set<String>
        + matchesKeyword(text: String): boolean
    }

    class SupportTeam {
        - id: String
        - name: String
        - handledCategories: Set<IncidentCategory>
        - teamLeadId: String
        - memberIds: Set<String>
        + addMember(technicianId: String): void
        + removeMember(technicianId: String): void
    }

    Incident *-- SlaTracker : composition
    Incident --> Employee : reporter
    Incident --> Technician : assignee
    Incident --> ItService : affects
    SupportTeam o-- Technician : aggregation
}

package "com.iitsm.domain.repository" {
    interface IncidentRepository <<Port>> {
        + save(incident: Incident): Incident
        + findById(id: String): Optional<Incident>
        + findByReporterId(reporterId: String): List<Incident>
        + findByStatus(status: IncidentStatus): List<Incident>
    }

    interface UserRepository <<Port>> {
        + save(user: User): User
        + findById(id: String): Optional<User>
        + findByEmail(email: Email): Optional<User>
    }

    interface TechnicianRepository <<Port>> {
        + findAvailableTechnicians(): List<Technician>
        + findBySupportTeamId(teamId: String): List<Technician>
    }
}

package "com.iitsm.infrastructure.persistence.adapter" {
    class IncidentRepositoryAdapter implements IncidentRepository {
        - springDataRepository: SpringDataIncidentRepository
    }

    class UserRepositoryAdapter implements UserRepository {
        - springDataRepository: SpringDataUserRepository
    }

    class TechnicianRepositoryAdapter implements TechnicianRepository {
        - springDataRepository: SpringDataUserRepository
    }
}

package "com.iitsm.application.service" {
    class UserFactory <<Factory>> {
        + createEmployee(...): Employee
        + createTechnician(...): Technician
        + createTeamLead(...): TeamLead
        + createAdministrator(...): Administrator
    }

    class UserService {
        - userRepository: UserRepository
        - userFactory: UserFactory
        - passwordEncoder: PasswordEncoder
        - tokenProvider: JwtTokenProvider
        + authenticate(email, password): AuthResult
        + registerEmployee(...): Employee
    }
}

package "com.iitsm.domain.policy" {
    interface AccessPolicy <<Policy>> {
        + enforceCanViewIncident(actor: User, incident: Incident): void
        + enforceCanExecuteAction(actor: User, incident: Incident, action: String): void
        + enforceAdmin(actor: User): void
    }
}

UserService --> UserFactory
UserService --> UserRepository
IncidentRepositoryAdapter ..> Incident : maps to/from
UserRepositoryAdapter ..> User : maps to/from

@enduml
